#compdef secretive

_secretive() {
    local line state

    _arguments -C \
        "1: :->cmds" \
        "*::arg:->args"

    case "$state" in
        cmds)
            local -a commands
            commands=(
                'key:Manage Secure Enclave keys'
                'cert:Manage OpenSSH certificates'
                'agent:Manage SecretAgent'
                'env:Print shell environment configuration'
                'version:Print version information'
            )
            _describe -t commands 'secretive command' commands
            ;;
        args)
            case $line[1] in
                key)
                    _arguments \
                        "1: :->key_cmds" \
                        "*::arg:->key_args"
                    case "$state" in
                        key_cmds)
                            local -a key_commands
                            key_commands=(
                                'list:List keys'
                                'show:Show key details'
                                'create:Create a new key'
                                'delete:Delete a key'
                                'rename:Rename a key'
                            )
                            _describe -t key_commands 'secretive key command' key_commands
                            ;;
                        key_args)
                            case $line[1] in
                                list) _arguments '--store[Filter by store]' '--json[JSON output]' ;;
                                show) _arguments '--public-key[Output public key]' '--fingerprint[Output fingerprint]' '--path[Output path]' '--json[JSON output]' ;;
                                create) _arguments '--type[Algorithm (ecdsa-256, mldsa-65, mldsa-87)]' '--auth[Auth level]' '--attribution[Attribution string]' '--exist-ok[Idempotent]' '--json[JSON output]' ;;
                                delete) _arguments '--force[Skip confirmation]' ;;
                                rename) _arguments '--name[New name]' '--attribution[New attribution]' ;;
                            esac
                            ;;
                    esac
                    ;;
                cert)
                    _arguments "1: :->cert_cmds" "*::arg:->cert_args"
                    case "$state" in
                        cert_cmds)
                            local -a cert_commands
                            cert_commands=('list:List imported certificates' 'import:Import a certificate' 'delete:Delete a certificate')
                            _describe -t cert_commands 'secretive cert command' cert_commands
                            ;;
                        cert_args)
                            case $line[1] in
                                list) _arguments '--json[JSON output]' ;;
                                import) _arguments '--name[Override name]' ;;
                                delete) _arguments '--force[Skip confirmation]' ;;
                            esac
                            ;;
                    esac
                    ;;
                agent)
                    _arguments "1: :->agent_cmds" "*::arg:->agent_args"
                    case "$state" in
                        agent_cmds)
                            local -a agent_commands
                            agent_commands=('status:Check agent status')
                            _describe -t agent_commands 'secretive agent command' agent_commands
                            ;;
                        agent_args)
                            case $line[1] in
                                status) _arguments '--json[JSON output]' ;;
                            esac
                            ;;
                    esac
                    ;;
                env)
                    _arguments '--shell[Target shell]'
                    ;;
            esac
            ;;
    esac
}

_secretive "$@"
